{
  "Name": "Ajazz AKP05 / Mirabox N4",
  "Description": "Device support plugin for Ajazz AKP05 (+variants)",
  "Author": "ambiso",
  "Version": "0.12.0",
  "PluginUUID": "com.github.ambiso.opendeck-akp05",
  "CodePathLin": "opendeck-akp05-linux",
  "CodePathMac": "opendeck-akp05-mac",
  "CodePathWin": "opendeck-akp05-win.exe",
  "Icon": "assets/icon",
  "Category": "Hardware",
  "OS": [
    { "Platform": "linux" },
    { "Platform": "mac", "MinimumVersion": "11.3" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Actions": [
    {
      "Name": "Knob LED Color",
      "UUID": "com.github.ambiso.opendeck-akp05.ledcolor",
      "Icon": "assets/icon",
      "Tooltip": "Set the knob LED color",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "pi/led.html",
      "States": [{ "Image": "assets/icon" }]
    },
    {
      "Name": "Knob LED Brightness",
      "UUID": "com.github.ambiso.opendeck-akp05.ledbrightness",
      "Icon": "assets/icon",
      "Tooltip": "Turn to change the knob LED brightness",
      "Controllers": ["Encoder"],
      "PropertyInspectorPath": "pi/led.html",
      "States": [{ "Image": "assets/icon" }]
    }
  ],
  "DeviceNamespace": "n4"
}
